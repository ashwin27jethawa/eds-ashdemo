{
  "definitions": [
    {
      "id": "support-hub",
      "title": "Support Hub",
      "description": "Support hub with tabs, categories and FAQs.",
      "type": "component",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "support-hub",
              "model": "support-hub-model",
              "filter": "support-hub-filter"
            }
          }
        }
      }
    }
  ],
  "filters": [
    {
      "id": "support-hub-filter",
      "components": [
        "page",
        "section",
        "container"
      ],
      "allowedComponents": [
        "support-hub"
      ]
    }
  ],
  "models": [
    {
      "id": "support-hub-model",
      "properties": [
        {
          "name": "tabs",
          "label": "Tabs",
          "type": "array",
          "items": {
            "type": "object",
            "properties": [
              {
                "name": "tabTitle",
                "label": "Tab Title",
                "type": "string",
                "component": "text",
                "required": true
              },
              {
                "name": "categories",
                "label": "Categories",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": [
                    {
                      "name": "categoryTitle",
                      "label": "Category Title",
                      "type": "string",
                      "component": "text",
                      "required": true
                    },
                    {
                      "name": "categoryIcon",
                      "label": "Category Icon",
                      "type": "string",
                      "component": "image"
                    },
                    {
                      "name": "questionCount",
                      "label": "Question Count",
                      "type": "string",
                      "component": "text"
                    },
                    {
                      "name": "faqs",
                      "label": "FAQs",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": [
                          {
                            "name": "question",
                            "label": "Question",
                            "type": "string",
                            "component": "text",
                            "required": true
                          },
                          {
                            "name": "answer",
                            "label": "Answer",
                            "type": "string",
                            "component": "richtext",
                            "required": true
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  ]
}