{
  "definitions": [
    {
      "id": "support-hub",
      "title": "Support Hub",
      "group": "Content",
      "description": "A comprehensive support center containing tabs, sidebar categories, and FAQ accordions.",
      "type": "component",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "models": [
              "support-hub-model"
            ]
          }
        }
      }
    }
  ],
  "filters": [
    {
      "id": "support-hub-filter",
      "components": [
        "container",
        "section",
        "page"
      ],
      "allowedComponents": [
        "support-hub"
      ]
    }
  ],
  "models": [
    {
      "id": "support-hub-model",
      "properties": [
        {
          "name": "tabs",
          "label": "Navigation Tabs",
          "description": "Add top-level tabs (e.g., My Account, About Folios).",
          "type": "array",
          "items": {
            "type": "object",
            "properties": [
              {
                "name": "tabTitle",
                "label": "Tab Title",
                "type": "string",
                "component": "text",
                "required": true
              },
              {
                "name": "categories",
                "label": "Sidebar Categories",
                "description": "Add categories under this tab (e.g., KYC, Bank Accounts).",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": [
                    {
                      "name": "categoryTitle",
                      "label": "Category Title",
                      "type": "string",
                      "component": "text",
                      "required": true
                    },
                    {
                      "name": "categoryIcon",
                      "label": "Category Icon",
                      "type": "string",
                      "component": "image"
                    },
                    {
                      "name": "questionCount",
                      "label": "Question Count Subtitle",
                      "description": "E.g., '24 Questions'",
                      "type": "string",
                      "component": "text"
                    },
                    {
                      "name": "faqs",
                      "label": "FAQs",
                      "description": "Add the actual questions and answers for this category.",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": [
                          {
                            "name": "question",
                            "label": "Question",
                            "type": "string",
                            "component": "text",
                            "required": true
                          },
                          {
                            "name": "answer",
                            "label": "Answer",
                            "type": "string",
                            "component": "richtext",
                            "required": true
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  ]
}