{
  "definitions": [
    {
      "id": "support-hub",
      "title": "Support Hub",
      "description": "Main container for the support center.",
      "type": "container",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": { "name": "support-hub", "filter": "support-hub-filter" }
          }
        }
      }
    },
    {
      "id": "support-hub-tab",
      "title": "Support Tab",
      "type": "container",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": { "name": "support-hub-tab", "model": "tab-model", "filter": "tab-filter" }
          }
        }
      }
    },
    {
      "id": "support-hub-category",
      "title": "Support Category",
      "type": "container",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": { "name": "support-hub-category", "model": "category-model", "filter": "category-filter" }
          }
        }
      }
    },
    {
      "id": "support-hub-faq",
      "title": "Support FAQ",
      "type": "component",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": { "name": "support-hub-faq", "model": "faq-model", "filter": "faq-filter" }
          }
        }
      }
    }
  ],
  "filters": [
    {
      "id": "support-hub-filter",
      "components": ["page", "section", "container"],
      "allowedComponents": ["support-hub"]
    },
    {
      "id": "tab-filter",
      "components": ["support-hub"],
      "allowedComponents": ["support-hub-tab"]
    },
    {
      "id": "category-filter",
      "components": ["support-hub-tab"],
      "allowedComponents": ["support-hub-category"]
    },
    {
      "id": "faq-filter",
      "components": ["support-hub-category"],
      "allowedComponents": ["support-hub-faq"]
    }
  ],
  "models": [
    {
      "id": "tab-model",
      "properties": [
        { "name": "tabTitle", "label": "Tab Title", "type": "string", "component": "text" }
      ]
    },
    {
      "id": "category-model",
      "properties": [
        { "name": "categoryTitle", "label": "Category Title", "type": "string", "component": "text" },
        { "name": "categoryIcon", "label": "Category Icon", "type": "string", "component": "image" }
      ]
    },
    {
      "id": "faq-model",
      "properties": [
        { "name": "question", "label": "Question", "type": "string", "component": "text" },
        { "name": "answer", "label": "Answer", "type": "string", "component": "richtext" }
      ]
    }
  ]
}